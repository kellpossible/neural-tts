[Unit]
Description=KDE TTS daemon
Requires=neural-tts.socket neural-tts-control.socket
After=neural-tts.socket neural-tts-control.socket

[Service]
Type=notify
NotifyAccess=main
WorkingDirectory=@REPO@
ExecStart=@DAEMON_PY@ -m neural_tts_daemon
Environment=PYTHONUNBUFFERED=1

# Sandboxing — the daemon needs read access to the repo (provider venvs live
# under it) and the user data dir (model files). It needs to write under
# ~/.config/speech-dispatcher (regenerating the AddVoice block),
# ~/.cache/neural-tts-daemon (provider scratch space — e.g. moss-tts-nano
# upstream wants an output_dir to mkdir at __init__ even if unused), and
# $XDG_RUNTIME_DIR (the sockets). pocket-tts reads its weights from the standard
# HF cache (~/.cache/huggingface, readable under ProtectHome=read-only): they are
# pre-fetched at install and read read-only at runtime, with HF in offline mode
# so no cache write-lock is attempted (see scripts/download_models + engine.py).
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=@REPO@ %h/.local/share/neural-tts-daemon
ReadWritePaths=%t %h/.config/neural-tts-daemon %h/.config/speech-dispatcher %h/.cache/neural-tts-daemon
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
# onnxruntime JITs; do not set MemoryDenyWriteExecute.

Restart=on-failure
RestartSec=2
TimeoutStartSec=15

[Install]
WantedBy=default.target
